# 环境变量参考；应用不会自动读取此文件，请在启动终端设置。
# 首次启动前设置管理员账号；之后修改环境变量不会重置已有账号密码。
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=replace-with-a-strong-password

# 可选；留空时首次启动自动生成 kb_store/secret.key。
# 更改或丢失主密钥会导致已保存的 API Key 无法解密。
APP_SECRET_KEY=

# 可选；模型目录或 Hugging Face 模型 ID。
# 离线评测要求显式使用已下载的本地目录。
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# 仅供命令行 API 评测；Web 页面中的 API 配置由每个用户单独填写。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
